(library
 (name ocaml_demo_apple_swiftui)
 (public_name ocaml_demo_apple.swiftui)
 (enabled_if
  (or
   (= %{context_name} default)
   (= %{context_name} default.ios)
   (= %{context_name} simulator)
   (= %{context_name} device.ios)
   (= %{context_name} simulator.ios)
   (= %{context_name} simulator-arm.ios)
   (= %{context_name} catalyst.ios)))
 (foreign_stubs
  (language c)
  (names ocaml_demo_apple_swiftui_stubs))
 (c_library_flags
  (:standard -framework Foundation -framework SwiftUI))
 (libraries ocaml_demo_apple))

(install
 (section lib)
 (package ocaml_demo_apple)
 (files
  (OCamlDemoSwiftUI.swift as swiftui/OCamlDemoSwiftUI.swift)
  (OCamlDemoSwiftUIMac.swift as swiftui/OCamlDemoSwiftUIMac.swift)))
