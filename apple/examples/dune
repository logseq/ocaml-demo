(subdir
 OCamlDemoMacDemos.app
 (rule
  (alias default)
  (deps Contents/Info.plist Contents/MacOS/OCamlDemoMacDemos)
  (enabled_if
   (= %{context_name} default))
  (action (progn)))
 (subdir
  Contents
  (rule
   (deps ../../Info.mac.plist)
   (targets Info.plist)
   (enabled_if
    (= %{context_name} default))
   (action
    (copy ../../Info.mac.plist Info.plist)))
  (subdir
   MacOS
   (rule
    (deps
     ../../../mac_app.exe
     ../../../../../scripts/apple-codesign-identity.sh)
    (targets OCamlDemoMacDemos)
    (enabled_if
     (= %{context_name} default))
    (action
     (progn
      (copy ../../../mac_app.exe OCamlDemoMacDemos)
      (run chmod u+w OCamlDemoMacDemos)
      (run strip -x OCamlDemoMacDemos)
      (run
       /bin/sh
       -c
       "codesign --force --sign \"$(%{dep:../../../../../scripts/apple-codesign-identity.sh})\" --timestamp=none OCamlDemoMacDemos")))))))
